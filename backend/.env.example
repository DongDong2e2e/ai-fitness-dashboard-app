# .env.example - 이 파일의 이름을 .env로 변경하고 아래 값들을 채워주세요.

# Gemini API Key
# Google AI Studio에서 API 키를 발급받으세요: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Report Recipient Email
# 생성된 리포트를 수신할 이메일 주소입니다. (이제 각 사용자 이메일로 발송되므로 비워둬도 됩니다)
REPORT_RECIPIENT_EMAIL=""

# JWT Secret Key
# FastAPI 애플리케이션의 보안을 위해 사용되는 비밀 키입니다.
# 아래 명령어로 새로운 키를 생성하여 사용할 수 있습니다.
# openssl rand -hex 32
SECRET_KEY="YOUR_SECRET_KEY_HERE"

# PostgreSQL Database Configuration
# docker-compose.yml 파일의 설정과 일치해야 합니다.
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="fitness_db"
POSTGRES_HOST="db" # docker-compose.yml에 정의된 서비스 이름입니다.
POSTGRES_PORT="5432"

# Email Configuration (SMTP를 통해 리포트 발송)
# Gmail 예시이며, "앱 비밀번호"를 생성해야 할 수 있습니다.
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=587
SENDER_EMAIL="your_sender_email@example.com"
SENDER_PASSWORD="YOUR_EMAIL_APP_PASSWORD"
