# Gitignore for AI Fitness Dashboard App

# Python
__pycache__/
*.pyc
*.pyd
*.pyo
.Python/
build/
dist/
venv/
.venv/
.pytest_cache/

# Node.js
node_modules/
/frontend/dist/
/frontend/build/
/frontend/.parcel-cache/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Docker
.dockerignore

# Logs
*.log
log/

# OS generated files
.DS_Store
.Trashes
Thumbs.db

# IDEs
.vscode/
.idea/

# Data directory (user-specific data)
/backend/app/data/
/backend/data
